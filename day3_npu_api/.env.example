# DAY 3 설정 예시. 각 조의 실제 장치·서버 포트로 바꿔 .env로 저장한다.
# Linux 서버에서는 source .env, Windows Python에서는 python-dotenv가 읽는다.
# 인증 토큰·비밀번호·개인키를 이 파일에 기록하지 않는다.
export TEAM_NPU_DEVICE=npu:__
export TEAM_SERVER_PORT=18___
export MODEL_ID=furiosa-ai/Qwen3-8B-FP8
# Windows PC에서 SSH -L 연결 후 접속하는 로컬 주소다.
# export OPENAI_BASE_URL=http://127.0.0.1:18___/v1
export OPENAI_BASE_URL=http://127.0.0.1:18103/v1
# 인증을 사용하지 않는 교육용 로컬 서버의 자리표시자다. 실제 비밀키가 아니다.
export OPENAI_API_KEY=EMPTY
